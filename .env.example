# --- Site ---
NEXT_PUBLIC_SITE_URL=https://rufus.exposql.com
NEXTAUTH_URL=https://rufus.exposql.com

# --- Database (Neon Postgres) ---
# Use the **pooled** Neon connection string for runtime (serverless),
# and the direct one only if you ever script migrations from your laptop.
DATABASE_URL=postgres://USER:PASSWORD@HOST/DB?sslmode=require

# --- NextAuth v5 ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace_with_long_random_string
AUTH_GOOGLE_ID=replace_with_google_oauth_client_id
AUTH_GOOGLE_SECRET=replace_with_google_oauth_client_secret

# --- Stripe (Exposql Checklist account, acct_1TZu9cDs5O82YiC2) ---
STRIPE_SECRET_KEY=sk_live_or_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Live price IDs we created — leave as-is unless swapping to test mode.
STRIPE_PRICE_STARTER=price_1TbysLDs5O82YiC2rqsujnfC
STRIPE_PRICE_GROWTH=price_1TbysMDs5O82YiC2CZ8E0FBs
STRIPE_PRICE_SCALE=price_1TbysMDs5O82YiC29g1ZgPS3
STRIPE_PRICE_PACK_100=price_1TbysNDs5O82YiC2NknzSA5H
STRIPE_PRICE_PACK_300=price_1TbysNDs5O82YiC24ankJlzm
STRIPE_PRICE_PACK_750=price_1TbysODs5O82YiC2mRXGWLOH
STRIPE_PRICE_PACK_2000=price_1TbysODs5O82YiC2nbO4luyS

# --- AI (Anthropic Claude — Sonnet 4.6 by default) ---
# Required for /api/ai/* endpoints. Without it, the in-app tools return 503.
ANTHROPIC_API_KEY=
# Optional override; default = claude-sonnet-4-6
ANTHROPIC_MODEL=

# --- Bootstrap (used once by /api/admin/db-setup to create tables) ---
SETUP_TOKEN=replace_with_long_random_string

# --- Admin panel ---
# Comma-separated emails that can see /app/admin and call /api/admin/*.
# Match exactly what Google returns (case-insensitive). Add a co-admin
# later by appending another email here — no redeploy needed once the env
# var updates.
ADMIN_EMAILS=you@exposql.com

# --- Vercel Blob (logo upload) ---
# Optional. Without it, logos can only be set by pasting a public URL.
# Generate at Vercel → Storage → Create Blob → reveal token.
BLOB_READ_WRITE_TOKEN=

# --- Email (Resend) ---
# Optional. Without it, welcome / proposal-viewed / out-of-credits emails
# silently skip. EMAIL_FROM must be a verified sender in your Resend account.
RESEND_API_KEY=
EMAIL_FROM="Rufus <hello@exposql.com>"

# --- Analytics (optional) ---
# Set NEXT_PUBLIC_GA4_ID or NEXT_PUBLIC_GTM_ID to start measuring. Scripts
# only load for users who accepted the analytics cookie category.
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GTM_ID=
