# --- Site ---
NEXT_PUBLIC_SITE_URL=https://rufus.exposql.com
NEXTAUTH_URL=https://rufus.exposql.com

# --- Database (Neon Postgres) ---
# Use the **pooled** Neon connection string for runtime (serverless),
# and the direct one only if you ever script migrations from your laptop.
DATABASE_URL=postgres://USER:PASSWORD@HOST/DB?sslmode=require

# --- NextAuth v5 ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace_with_long_random_string
AUTH_GOOGLE_ID=replace_with_google_oauth_client_id
AUTH_GOOGLE_SECRET=replace_with_google_oauth_client_secret

# --- Stripe (Exposql Checklist account, acct_1TZu9cDs5O82YiC2) ---
STRIPE_SECRET_KEY=sk_live_or_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Live price IDs we created — leave as-is unless swapping to test mode.
STRIPE_PRICE_STARTER=price_1TbysLDs5O82YiC2rqsujnfC
STRIPE_PRICE_GROWTH=price_1TbysMDs5O82YiC2CZ8E0FBs
STRIPE_PRICE_SCALE=price_1TbysMDs5O82YiC29g1ZgPS3
STRIPE_PRICE_PACK_100=price_1TbysNDs5O82YiC2NknzSA5H
STRIPE_PRICE_PACK_300=price_1TbysNDs5O82YiC24ankJlzm
